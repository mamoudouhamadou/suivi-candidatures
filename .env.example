# Variables pour « docker compose ». Copier en .env (jamais commité) et remplir.

# Clé qui signe les jetons JWT (32 caractères minimum). Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"

# Facultatif : mot de passe PostgreSQL (par défaut : suivi_dev).
# ⚠️ Il n'est pris en compte qu'à la PREMIÈRE création de la base (volume vide).
# POSTGRES_PASSWORD="un-mot-de-passe-solide"

# Facultatif : certificat racine d'un antivirus ou d'un proxy qui inspecte le HTTPS
# (sinon « npm ci » échoue dans Docker avec UNABLE_TO_VERIFY_LEAF_SIGNATURE).
# Avast : C:/ProgramData/Avast Software/Avast/wscert.pem
# CA_SUPPLEMENTAIRE="C:/chemin/vers/certificat-racine.pem"

# Facultatif : port de l'application sur ta machine (par défaut 8080)
# PORT_WEB=8081
