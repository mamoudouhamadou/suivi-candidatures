// Schéma de la base de données : Prisma en déduit les tables SQL (migrations)
// et un client TypeScript typé (src/generated/prisma).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Statut {
  a_envoyer
  envoyee
  entrevue
  offre
  refusee
}

model Utilisateur {
  id              Int           @id @default(autoincrement())
  courriel        String        @unique
  motDePasseHache String // jamais le mot de passe en clair !
  nom             String?
  creeLe          DateTime      @default(now())
  candidatures    Candidature[] // relation 1-N : un utilisateur a plusieurs candidatures
}

model Candidature {
  id            Int         @id @default(autoincrement())
  entreprise    String
  poste         String
  statut        Statut      @default(a_envoyer)
  dateEnvoi     DateTime?   @db.Date
  lien          String?
  notes         String?
  creeLe        DateTime    @default(now())
  modifieLe     DateTime    @updatedAt
  // Clé étrangère : chaque candidature appartient à un utilisateur.
  // onDelete: Cascade → supprimer l'utilisateur supprime ses candidatures.
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, statut])
}
